# Desarrollo local: copia a .env. En Railway define estas variables en el panel (Variables).
GEMINI_API_KEY=pega_aqui_tu_llave
GEMINI_MODEL=gemini-3.8-flash
# Solo local; Railway inyecta PORT automáticamente.
PORT=3000
# Solicitudes de chat por minuto y por IP
RATE_LIMIT_PER_MIN=20
# Opcional: URL pública para sitemap y canonical (Railway rellena RAILWAY_PUBLIC_DOMAIN solo)
# PUBLIC_URL=https://tu-dominio.com
